# Copy to `.env` locally or paste keys into Dokploy → Environment (never commit `.env`).

# Public URL (required behind Traefik/TLS — must match your Dokploy domain).
NEXT_PUBLIC_APP_URL=https://r2-manager.example.com

# ─── Web login (required for production) ─────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-strong-password
# Signs session cookies; generate: openssl rand -hex 32
AUTH_SECRET=

# ─── Cloudflare R2 (Storage UI native vars) ──────────────────────────────────
# Provider `r2` uses Cloudflare account ID for the S3 API endpoint.
# Generic names many guides use → map here:
#   S3_BUCKET              → STORAGE_1_BUCKET
#   S3_ACCESS_KEY_ID       → STORAGE_1_ACCESS_KEY_ID
#   S3_SECRET_ACCESS_KEY   → STORAGE_1_SECRET_ACCESS_KEY
#   S3_REGION=auto         → ignored for provider r2 (region is auto)
#   S3_ENDPOINT            → optional override via STORAGE_1_ENDPOINT instead of ACCOUNT_ID

STORAGE_1_PROVIDER=r2
STORAGE_1_NAME=R2 Production
STORAGE_1_ACCOUNT_ID=
STORAGE_1_BUCKET=
STORAGE_1_ACCESS_KEY_ID=
STORAGE_1_SECRET_ACCESS_KEY=

# Optional: custom endpoint instead of deriving from ACCOUNT_ID
# STORAGE_1_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Optional: disable upload/delete/rename for this bucket
# STORAGE_1_READ_ONLY=true

# Optional second bucket (uncomment and fill)
# STORAGE_2_PROVIDER=r2
# STORAGE_2_NAME=R2 Archive
# STORAGE_2_ACCOUNT_ID=
# STORAGE_2_BUCKET=
# STORAGE_2_ACCESS_KEY_ID=
# STORAGE_2_SECRET_ACCESS_KEY=

# Alternative: any S3-compatible endpoint (not MinIO server — client API only)
# STORAGE_1_PROVIDER=s3-compatible
# STORAGE_1_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_1_REGION=auto
# STORAGE_1_BUCKET=
# STORAGE_1_ACCESS_KEY_ID=
# STORAGE_1_SECRET_ACCESS_KEY=
# STORAGE_1_FORCE_PATH_STYLE=false

# Optional: Cloudflare Turnstile on login (both keys required)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
